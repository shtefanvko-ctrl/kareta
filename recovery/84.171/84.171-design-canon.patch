+const fs=require('fs'),path=require('path'),assert=require('assert');
+const root=path.resolve(__dirname,'..');
+const read=p=>fs.readFileSync(path.join(root,p),'utf8');
+const registry=read('inc/asset_registry.php');
+const design=read('css/next/design_contract.css');
+const shell=read('css/next/master_shell_canonical_84_143.css');
+const surfaces=read('css/next/master_surfaces.css');
+const exchange=read('css/next/master_ui_exchange_schedule_flattening.css');
+const runtime=read('css/routes/master_runtime.css');
+const build=read('tools/build_master_runtime_css.js');
+
+for(const token of ['--k-z-base:0','--k-z-content:1','--k-z-sticky:20','--k-z-shell:40','--k-z-nav:50','--k-z-fab:60','--k-z-overlay:80','--k-z-modal:100','--k-z-toast:120','--k-z-debug:200']) assert(design.includes(token),`missing ${token}`);
+assert(registry.indexOf("'css/runtime_boot_bundle.css'") < registry.indexOf("'css/next/design_contract.css'"),'design contract must load after legacy boot bundle');
+assert(registry.indexOf("'css/next/design_contract.css'") < registry.indexOf("'css/next/master_shell_canonical_84_143.css'"),'tokens must load before master shell');
+for(const [name,text] of [['design',design],['shell',shell],['surfaces',surfaces],['exchange',exchange]]) assert(!/z-index\s*:\s*-?\d+/i.test(text),`${name} contains raw numeric z-index`);
+for(const bp of ['@media(max-width:767px)','@media(min-width:768px) and (max-width:1199px)','@media(min-width:1200px)']) assert(shell.includes(bp),`master shell missing ${bp}`);
+assert(shell.includes('grid-template-columns:repeat(6,minmax(0,1fr))!important'),'phone master nav must be six columns');
+assert(!shell.includes('@media(max-width:599px)'),'old 3+3 phone dock must be retired');
+assert(!shell.includes('grid-template-rows:repeat(2'),'phone dock must never become two rows');
+assert(exchange.includes('MASTER EXCHANGE VISUAL CANON'),'exchange canon missing');
+assert(exchange.includes('@media(max-width:767px)'),'exchange phone contract missing');
+assert(exchange.includes('grid-template-columns:minmax(0,1fr);gap:12px'),'exchange phone must be one column');
+assert(exchange.includes('grid-template-columns:repeat(2,minmax(0,1fr));gap:14px'),'exchange desktop/tablet two-card density missing');
+assert(surfaces.includes('MASTER SURFACE CANON V1'),'master surface owner missing');
+assert(!fs.existsSync(path.join(root,'css/next/master_client_r84_postlude.css')),'postlude patch file must not be introduced');
+assert(build.includes("'css/next/master_surfaces.css'"));
+assert(build.includes("'css/next/master_ui_exchange_schedule_flattening.css'"));
+assert(runtime.includes('MASTER SURFACE CANON V1') && runtime.includes('MASTER EXCHANGE VISUAL CANON'),'generated master runtime missing canon sections');
+console.log('PASS: design canon 84.171; global layer tokens; single master shell owner; 6-item one-row phone dock; dedicated tablet/desktop; exchange client-style responsive contract; no postlude.');
