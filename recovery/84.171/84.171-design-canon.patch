+'use strict';
+const fs=require('fs'),path=require('path');
+const root=path.resolve(__dirname,'..');
+const walk=(dir,out=[])=>{for(const e of fs.readdirSync(dir,{withFileTypes:true})){const p=path.join(dir,e.name);e.isDirectory()?walk(p,out):out.push(p)}return out};
+const css=walk(path.join(root,'css')).filter(p=>p.endsWith('.css'));
+const rel=p=>path.relative(root,p).replace(/\\/g,'/');
+let z=0,important=0;
+const legacy=[];
+for(const p of css){const t=fs.readFileSync(p,'utf8');z+=(t.match(/z-index\s*:/g)||[]).length;important+=(t.match(/!important/g)||[]).length;if(/canonical|recovery|restore|phase|modernization|legacy/i.test(rel(p)))legacy.push(rel(p));}
+const owners=['css/next/design_contract.css','css/next/master_shell_canonical_84_143.css','css/next/master_surfaces.css','css/next/master_ui_exchange_schedule_flattening.css'];
+const ownerRawZ=owners.flatMap(p=>{const t=fs.readFileSync(path.join(root,p),'utf8');return [...t.matchAll(/z-index\s*:\s*(-?\d+)/gi)].map(m=>({file:p,value:m[1]}));});
+const result={releaseTarget:'188.5.5.6.84.171',cssFiles:css.length,zIndexDeclarations:z,importantDeclarations:important,legacyNamedFiles:legacy.length,legacyFiles:legacy,canonicalOwners:owners,canonicalOwnerRawNumericZIndex:ownerRawZ,policy:'legacy remains frozen until hosting browser acceptance; new Master design changes must land only in canonical owners'};
+console.log(JSON.stringify(result,null,2));
+if(ownerRawZ.length)process.exit(1);
