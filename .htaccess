# KARETA.KZ deployment hardening

Options -Indexes
DirectoryIndex index.php

AddDefaultCharset UTF-8

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(self), camera=(self), microphone=(self)"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Never expose internal deployment/documentation folders.
  RewriteRule ^(docs|storage/logs|storage/backups|tools)(/|$) - [F,L]
  RewriteRule ^config\.private\.php$ - [F,L]
  RewriteRule ^config\.(?:private|server-test)\.example\.php$ - [F,L]
  RewriteRule ^_SERVER_[A-Za-z0-9_.-]+$ - [F,L]

  # Protect dotfiles except well-known ACME folder.
  RewriteRule (^|/)\.(?!well-known/) - [F,L]

  # R186.5 Identity Context Engine clean endpoints.
  RewriteRule ^api/context/(list|current|select)/?$ api/context.php?action=$1 [QSA,L]
  RewriteRule ^api/capabilities/(current|check)/?$ api/capabilities.php?action=$1 [QSA,L]

  # Keep real files/directories and API endpoints untouched.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Missing static resources must never fall through to the SPA document.
  # Returning index.php for a .css/.js request produces text/html + nosniff and
  # manifests in WebView as route_style_load_failed / route_script_load_failed.
  RewriteCond %{REQUEST_URI} \.(?:css|js|mjs|map|png|jpe?g|webp|svg|gif|ico|woff2?|ttf)$ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ - [R=404,L]

  # SPA fallback for clean URLs. Mark the internal fallback so index.php can
  # return a real HTTP 404 while still rendering the application 404 surface.
  RewriteRule ^ index.php?kareta_route_fallback=1 [QSA,L]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>


# KARETA active patch cache policy
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|index\.php|manifest\.json)$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set CDN-Cache-Control "no-store"
    Header always set Surrogate-Control "no-store"
    Header always set Pragma "no-cache"
  </FilesMatch>
  <FilesMatch "\.(js|css)$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  </FilesMatch>
</IfModule>

# R186.5 identity session core
RewriteRule ^api/identity/session/?$ api/identity_session.php [L,QSA]
