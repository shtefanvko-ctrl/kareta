{
  "schema": "kareta.harness.server-package-policy.v1",
  "runtimeFiles": [
    ".htaccess",
    "index.php",
    "booking.php",
    "asset_manifest.php",
    "manifest.json",
    "sw.js",
    "config.php"
  ],
  "runtimePrefixes": [
    "api/",
    "inc/",
    "css/",
    "js/",
    "assets/",
    "media/",
    "storage/"
  ],
  "opsFiles": [
    "tools/server_preflight.php",
    "tools/verify_runtime.php",
    "tools/verify_runtime_provenance.py",
    "tools/verify_staging_current.py",
    "tools/generate_deployment_manifest.php",
    "tools/identity_migrate.php",
    "tools/messaging_schema_install.php",
    "tools/messaging_worker.php",
    "tools/backup_project.php",
    "tools/cleanup_runtime.php",
    "tools/verify_assets.php",
    "tools/verify_connectivity.php"
  ],
  "artifactSidecars": [
    "config.server-test.example.php",
    "config.private.example.php",
    "docs/release/current.json"
  ],
  "emptyRuntimeDirs": [
    "storage/logs",
    "storage/backups",
    "storage/uploads"
  ],
  "forbiddenPackagePaths": [
    "config.private.php",
    ".env",
    ".git/",
    ".github/",
    "harness/",
    "ai/",
    "tools/archive/",
    "storage/logs/",
    "storage/backups/",
    "storage/runtime/",
    "storage/deployment_manifest.json"
  ],
  "forbiddenSuffixes": [
    ".sql",
    ".bak",
    ".pem",
    ".key",
    ".p12",
    ".pfx",
    "~"
  ],
  "forbiddenContentMarkers": [
    "-----BEGIN PRIVATE KEY-----",
    "-----BEGIN RSA PRIVATE KEY-----",
    "-----BEGIN OPENSSH PRIVATE KEY-----"
  ]
}
