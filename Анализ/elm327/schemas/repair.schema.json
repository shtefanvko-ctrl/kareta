{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KARETA repair action",
  "type": "object",
  "required": [
    "id",
    "title",
    "requires_confirmation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]+$"
    },
    "title": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": [
        "ru",
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "ru": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "requires_confirmation": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
