{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KARETA source registry entry",
  "type": "object",
  "required": [
    "id",
    "name",
    "type",
    "authority",
    "url",
    "license",
    "use",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "authority": {
      "type": "string"
    },
    "url": {
      "type": [
        "string",
        "null"
      ]
    },
    "license": {
      "type": "string"
    },
    "use": {
      "type": "string"
    },
    "status": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
